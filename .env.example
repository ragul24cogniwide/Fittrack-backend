# ==============================================================================
# FitTrack Backend - Environment Variables
# Copy to .env for local development. On Render, add these under
# Dashboard -> your service -> Environment. NEVER put real values in this file.
# ==============================================================================

PROJECT_NAME="Movements+ & FitTrack API"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=False

# NeonDB connection string (Neon dashboard -> Connect). Any of these forms work:
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require"

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="CHANGE_ME"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

BACKEND_CORS_ORIGINS=["*"]

# Google sign-in: Google Cloud Console -> APIs & Services -> Credentials ->
# Create OAuth client ID -> "Web application". Add this Authorized redirect URI:
#   {PUBLIC_BASE_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PUBLIC_BASE_URL="https://fittrack-backend-nqkx.onrender.com"
